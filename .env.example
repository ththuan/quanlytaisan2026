# ============================================
# Database Configuration
# ============================================
DB_USER=postgres
# Production: dùng mật khẩu mạnh, không dùng 'postgres'
DB_PASSWORD=postgres
DB_NAME=asset_management
DB_PORT=5432

# ============================================
# Backend Configuration
# ============================================
NODE_ENV=development
BACKEND_PORT=5000
HOST=0.0.0.0
# Production: giới hạn origin cụ thể, VD: https://yourdomain.com
CORS_ORIGIN=*
FRONTEND_URL=http://localhost:4000
# Production: tạo secret ngẫu nhiên mạnh (≥32 ký tự). Chạy: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-change-in-production
# Mật khẩu mặc định cho user mới / reset. Production: đổi mật khẩu mạnh
DEFAULT_PASSWORD=Ctec@123
# Giới hạn body (mặc định 10MB). Nếu cần upload ảnh base64 lớn: BODY_LIMIT=50mb
BODY_LIMIT=10mb
LOG_LEVEL=info

# ============================================
# Redis Configuration (cache, session, rate limit)
# ============================================
# Production: redis://redis:6379 (dùng trong Docker)
# Local dev không Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_PORT=4000
VITE_API_BASE_URL=/api
# HTTP (mặc định): VITE_HTTPS=false → mở http://localhost:4000
# HTTPS: VITE_HTTPS=true → mở https://localhost:4000 (can camera, PWA)
# Vite tu dong dung cert tu nginx/ssl neu ton tai, hoac basic-ssl auto-generate
VITE_HTTPS=true

# ============================================
# Docker / Network Configuration
# ============================================
VITE_PROXY_TARGET=http://localhost:5000

# ============================================
# Cloudflare Tunnel (public ra internet với domain cố định)
# ============================================
# 1. Vào https://one.dash.cloudflare.com/ → Networks → Tunnels → Create
# 2. Copy token, dán vào đây:
CF_TUNNEL_TOKEN=
