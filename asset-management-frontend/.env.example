# Environment (khi dùng HTTPS: đặt VITE_API_BASE_URL=/api và VITE_HTTPS=true)
VITE_API_BASE_URL=/api
VITE_HTTPS=true
# Proxy /api sang backend. Local: http://localhost:5000. Docker: http://backend:5000 (mặc định)
VITE_PROXY_TARGET=http://localhost:5000
VITE_APP_TITLE=Phần mềm Quản lý tài sản
VITE_APP_VERSION=1.0.0

# Features
VITE_ENABLE_EXCEL_EXPORT=true
VITE_ENABLE_PDF_EXPORT=true
