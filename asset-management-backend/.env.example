# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=asset_management
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_DIALECT=postgres
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# JWT Configuration
# Production: bắt buộc secret mạnh ≥32 ký tự (chạy: node scripts/generate-secrets.js)
JWT_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Bcrypt Configuration
BCRYPT_ROUNDS=10

# CORS Configuration
CORS_ORIGIN=http://localhost:4000
FRONTEND_URL=http://localhost:4000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=100

# Upload Configuration
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/jpg

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Redis (cache, session, rate limit - optional, app works without it)
REDIS_URL=redis://localhost:6379

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@assetmanagement.com

# Admin Default Account
# Tên tài khoản admin là cố định 'admin'. Mật khẩu đọc từ ADMIN_PASSWORD (hoặc SYSTEM_ADMIN_PASSWORD).
# Production: bắt buộc đặt mật khẩu mạnh khác 'Admin@123'.
ADMIN_PASSWORD=Admin@123
# Mật khẩu mặc định cho user mới / import user (không áp dụng cho admin)
DEFAULT_PASSWORD=Ctec@123
