# Production Environment - Nội bộ HTTPS
# Sao chép file này thành .env.prod và điền giá trị thực

# ============================================
# Database
# ============================================
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=asset_management

# ============================================
# Backend
# ============================================
NODE_ENV=production
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_MIN_32_CHARS
DEFAULT_PASSWORD=Ctec@123
LOG_LEVEL=info
CORS_ORIGIN=*
FRONTEND_URL=https://your-domain.com
