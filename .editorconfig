# editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.{sh,ps1,bat,cmd}]
end_of_line = lf

[*.ps1]
end_of_line = crlf

[*.bat]
end_of_line = crlf

[Dockerfile*]
indent_size = 4

[Makefile]
indent_style = tab
