# Development Dockerfile cho Backend
FROM node:18-alpine

WORKDIR /app

# Install dependencies cần thiết cho development
RUN apk add --no-cache python3 make g++

# Copy package files
COPY package*.json ./

# Install all dependencies (bao gồm devDependencies)
RUN npm ci

# Copy source code
COPY . .

# Expose port
EXPOSE 5000

# Run dev server với nodemon
CMD ["npm", "run", "dev"]
