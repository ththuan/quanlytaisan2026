# Production Environment - Nội bộ HTTPS
# Sao chép file này thành .env.prod và điền giá trị thực

# ============================================
# Database
# ============================================
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=asset_management

# ============================================
# Backend
# ============================================
NODE_ENV=production
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_MIN_32_CHARS
DEFAULT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
LOG_LEVEL=info
# Domain public qua Cloudflare Tunnel. VD: https://quanlytaisanctec.dpdns.org
CORS_ORIGIN=https://quanlytaisanctec.dpdns.org
FRONTEND_URL=https://quanlytaisanctec.dpdns.org

# ============================================
# Cloudflare Tunnel (public ra internet qua domain co dinh)
# ============================================
# 1. https://one.dash.cloudflare.com/ -> Networks -> Tunnels -> Create a tunnel (Cloudflared)
# 2. Dat ten tunnel, copy Token o buoc cai dat connector, dan vao day
# 3. Public Hostname: quanlytaisanctec.dpdns.org -> Service: http://nginx:80
# 4. Chay: docker compose -f docker-compose.prod.yml --profile cloudflare up -d --build
CF_TUNNEL_TOKEN=CHANGE_ME_CLOUDFLARE_TUNNEL_TOKEN
